import random
import numpy as np
from colorama import init, Fore, Style
from typing import List, Tuple
import os

init()

# Scoring system for alignment
MATCH_SCORE = 2
MISMATCH_SCORE = -1
GAP_PENALTY = -2

def read_fasta(file_path: str) -> List[Tuple[str, str]]:
    """
    Reads a FASTA file and returns a list of tuples (ID, sequence).
    """
    sequences = []
    current_seq = ""
    current_id = ""
    with open(file_path, 'r') as f:
        for line in f:
            line = line.strip()
            if line.startswith('>'):
                if current_seq:
                    sequences.append((current_id, current_seq))
                    current_seq = ""
                current_id = line[1:]
            else:
                current_seq += line
        if current_seq:
            sequences.append((current_id, current_seq))
    return sequences

def initialize_population(sequences: List[str], pop_size: int) -> List[List[str]]:
    """
    Initializes the population by randomly adding gaps to align sequences.
    """
    max_len = max(len(seq) for seq in sequences)
    population = []
    for _ in range(pop_size):
        individual = []
        for seq in sequences:
            aligned_seq = list(seq)
            gaps_to_add = max_len - len(seq)
            for _ in range(gaps_to_add):
                pos = random.randint(0, len(aligned_seq))
                aligned_seq.insert(pos, '-')
            individual.append(''.join(aligned_seq))
        population.append(individual)
    return population

def calculate_fitness(alignment: List[str]) -> int:
    """
    Calculates the fitness score of an alignment.
    """
    score = 0
    for i in range(len(alignment[0])):
        column = [seq[i] for seq in alignment]
        for j in range(len(column)):
            for k in range(j + 1, len(column)):
                if column[j] == column[k]:
                    if column[j] != '-':
                        score += MATCH_SCORE
                elif column[j] == '-' or column[k] == '-':
                    score += GAP_PENALTY
                else:
                    score += MISMATCH_SCORE
    return score

def select_parents(population: List[List[str]], fitness_scores: List[int]) -> Tuple[List[str], List[str]]:
    """
    Selects two best individuals from the population based on fitness scores.
    """
    sorted_indices = np.argsort(fitness_scores)[::-1]
    return population[sorted_indices[0]], population[sorted_indices[1]]

def crossover(parent1: List[str], parent2: List[str]) -> Tuple[List[str], List[str]]:
    """
    Performs crossover at the midpoint of each sequence.
    """
    midpoint = len(parent1[0]) // 2
    child1, child2 = [], []
    for s1, s2 in zip(parent1, parent2):
        child1.append(s1[:midpoint] + s2[midpoint:])
        child2.append(s2[:midpoint] + s1[midpoint:])
    return child1, child2

def mutate(alignment: List[str], mutation_rate: float) -> List[str]:
    """
    Applies mutation by swapping gap positions in the sequence.
    """
    mutated = []
    for seq in alignment:
        seq_list = list(seq)
        if random.random() < mutation_rate:
            gap_positions = [i for i, char in enumerate(seq_list) if char == '-']
            if gap_positions:
                gap_pos = random.choice(gap_positions)
                new_pos = random.randint(0, len(seq_list) - 1)
                seq_list[gap_pos], seq_list[new_pos] = seq_list[new_pos], seq_list[gap_pos]
        mutated.append(''.join(seq_list))
    return mutated

def genetic_algorithm(sequences: List[str], pop_size: int = 100, generations: int = 100, mutation_rate: float = 0.1) -> List[str]:
    """
    Runs the genetic algorithm to find the best multiple sequence alignment.
    """
    population = initialize_population(sequences, pop_size)
    print("Initial Alignment (with gaps):")
    for seq in population[0]:
        print(seq)
    print("-" * 50)

    for _ in range(generations):
        fitness_scores = [calculate_fitness(ind) for ind in population]
        new_population = []

        elite_size = max(1, int(pop_size * 0.2))
        elite_indices = np.argsort(fitness_scores)[-elite_size:]
        elites = [population[i] for i in elite_indices]
        new_population.extend(elites)

        while len(new_population) < pop_size:
            parent1, parent2 = select_parents(population, fitness_scores)
            child1, child2 = crossover(parent1, parent2)
            child1 = mutate(child1, mutation_rate)
            child2 = mutate(child2, mutation_rate)
            new_population.extend([child1, child2])

        population = new_population[:pop_size]

    final_scores = [calculate_fitness(ind) for ind in population]
    best_index = np.argmax(final_scores)
    return population[best_index]

def print_colored_alignment(alignment: List[str], ids: List[str]):
    """
    Prints aligned sequences with colors indicating match, mismatch, and gaps.
    """
    alignment_len = len(alignment[0])
    conservation = []
    for i in range(alignment_len):
        column = [seq[i] for seq in alignment]
        if all(c == column[0] and c != '-' for c in column):
            conservation.append('perfect')
        elif '-' not in column:
            conservation.append('mismatch')
        else:
            conservation.append('gap')
    for id_, seq in zip(ids, alignment):
        colored_seq = ""
        for char, cons in zip(seq, conservation):
            if cons == 'perfect':
                colored_seq += Fore.GREEN + char + Style.RESET_ALL
            elif cons == 'mismatch':
                colored_seq += Fore.RED + char + Style.RESET_ALL
            else:
                colored_seq += Fore.YELLOW + char + Style.RESET_ALL
        print(f"{id_:<20} {colored_seq}")

def main(fasta_file: str):
    sequences_data = read_fasta(fasta_file)
    ids = [seq[0] for seq in sequences_data]
    sequences = [seq[1] for seq in sequences_data]

    print("Original Sequences:")
    for id_, seq in zip(ids, sequences):
        print(f"{id_:<20} {seq}")
    print("\nPerforming MSA...\n")

    alignment = genetic_algorithm(sequences)

    print("\nFinal Aligned Sequences (with colors):")
    print_colored_alignment(alignment, ids)

    final_score = calculate_fitness(alignment)
    print(f"\nFinal alignment score: {final_score}")

if __name__ == "__main__":
    sample_fasta = ">Seq1\nATGCGATACGTATAG\n>Seq2\nATGCGGGTTAG\n>Seq3\nATGCGATATCGTTAGAA\n"
    with open("sample.fasta", "w") as f:
        f.write(sample_fasta)

    main("sample.fasta")
    os.remove("sample.fasta")
